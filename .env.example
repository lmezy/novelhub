# =====================
# NovelHub Environment
# =====================

PROJECT_NAME=NovelHub

# PostgreSQL
POSTGRES_DB=novelhub
POSTGRES_USER=novelhub
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql+asyncpg://novelhub:CHANGE_ME@postgres:5432/novelhub

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Meilisearch
MEILI_MASTER_KEY=CHANGE_ME

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173

# Timezone
TZ=Asia/Shanghai

# JWT
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Cookie encryption
COOKIE_SECRET=CHANGE_ME

# Meilisearch
MEILI_HOST=http://meilisearch:7700
MEILI_KEY=CHANGE_ME_meili_key

# Storage
STORAGE_PATH=/app/storage/books

# Local Markdown import: host directory mounted into the container at /imports
LOCAL_IMPORT_VOLUME=./data/imports
# Container-visible roots selectable in the local import UI
LOCAL_IMPORT_ROOTS=/app/storage/imports,/imports,/library

# Crawler
# Fallback request interval when a book source has no concurrentRate.
# 1200ms is safer for full-site sync; set 0 to match Legado's unthrottled default.
CRAWL_DELAY_MS=1200
# Long-running syncs pause briefly every N requests to avoid tripping site WAFs.
SYNC_RATE_COOLDOWN_EVERY=300
SYNC_RATE_COOLDOWN_SECONDS=10
# Effective thread pool size used for page/chapter fetches (Legado caps at 9)
SYNC_THREAD_COUNT=9
# Chapter download concurrency
SYNC_CHAPTER_CONCURRENCY=9
# Concurrent books during full-site sync (1 = fully sequential)
SYNC_BOOK_CONCURRENCY=3
# false waits for the current 3-book batch to finish before starting the next
# batch (safer for anti-bot limits); true starts the next book as soon as one
# book in the batch finishes
SYNC_BOOK_CONTINUOUS=false
# Set to true to ignore book source concurrentRate and use the chapter concurrency above
SYNC_IGNORE_RATE_LIMIT=false
# How many book sources may sync at the same time.
# 0 = unlimited: every source gets its own worker, so one multi-hour full-site
# task can no longer block the other sources. Set a positive number only to keep
# a global ceiling on a small host. A single source never runs two tasks at once,
# and each source keeps its own request pacing either way.
SYNC_WORKER_CONCURRENCY=0
# Concurrent catalog categories (exploreUrl kinds) fetched per source. This does
# not raise the request rate a site sees: the source's own rate limiter still
# spaces every request.
YUEDU_EXPLORE_CONCURRENCY=4
# Stop a full-site task after N pages and automatically re-queue it (0 = unlimited)
SYNC_PAGE_BATCH_SIZE=0
# Delay before a batched task is re-queued, in milliseconds
SYNC_BATCH_INTERVAL_MS=5000
# Queue worker liveness. The crawler container (PID 1) restarts itself when the
# queue loop stops touching this file, because a worker whose loop hangs stays
# alive while consuming no task at all -- nothing else can see that.
# How long the signal may stay untouched before the worker counts as hung. The
# queue loop iterates at least every 2s even while idle, so only a real hang
# reaches this. 0 / junk falls back to the default.
SYNC_QUEUE_HEARTBEAT_TIMEOUT_SECONDS=300
# Where the signal lives; the container entry point and the worker both read it.
SYNC_QUEUE_HEARTBEAT_PATH=/tmp/novelhub_queue_heartbeat

# =====================
# AI Configuration
# =====================

# Provider: openai | claude | qwen | ollama | hermes
AI_PROVIDER=openai
AI_API_KEY=sk-your-api-key
# AI_BASE_URL=  (optional, custom endpoint)
# AI_MODEL=     (optional, uses provider default)

# =====================
# Storage Backend
# =====================

# local | s3 | webdav
STORAGE_BACKEND=local

# S3/MinIO settings (when STORAGE_BACKEND=s3)
# S3_ENDPOINT=
# S3_BUCKET=novelhub-books
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# WebDAV settings (when STORAGE_BACKEND=webdav)
# WEBDAV_URL=
# WEBDAV_USER=
# WEBDAV_PASS=

# =====================
# API Tokens
# =====================
# Generate via POST /api/tokens
