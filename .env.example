# =====================
# NovelHub Environment
# =====================

PROJECT_NAME=NovelHub

# PostgreSQL
POSTGRES_DB=novelhub
POSTGRES_USER=novelhub
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql+asyncpg://novelhub:CHANGE_ME@postgres:5432/novelhub

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Meilisearch
MEILI_MASTER_KEY=CHANGE_ME

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173

# Timezone
TZ=Asia/Shanghai

# JWT
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Cookie encryption
COOKIE_SECRET=CHANGE_ME

# Meilisearch
MEILI_HOST=http://meilisearch:7700
MEILI_KEY=CHANGE_MEili_key

# Storage
STORAGE_PATH=/app/storage/books

# Crawler
# Safe delay between HTTP requests, in milliseconds
CRAWL_DELAY_MS=1200
# Chapter download concurrency (yuedu defaults to 16 threads)
SYNC_CHAPTER_CONCURRENCY=12

# =====================
# AI Configuration
# =====================

# Provider: openai | claude | qwen | ollama | hermes
AI_PROVIDER=openai
AI_API_KEY=sk-your-api-key
# AI_BASE_URL=  (optional, custom endpoint)
# AI_MODEL=     (optional, uses provider default)

# =====================
# Storage Backend
# =====================

# local | s3 | webdav
STORAGE_BACKEND=local

# S3/MinIO settings (when STORAGE_BACKEND=s3)
# S3_ENDPOINT=
# S3_BUCKET=novelhub-books
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# WebDAV settings (when STORAGE_BACKEND=webdav)
# WEBDAV_URL=
# WEBDAV_USER=
# WEBDAV_PASS=

# =====================
# API Tokens
# =====================
# Generate via POST /api/tokens
