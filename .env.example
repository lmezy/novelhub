# =====================
# NovelHub Environment
# =====================

PROJECT_NAME=NovelHub
# Shown by GET / and in the OpenAPI schema; leave it alone unless you need a
# distinct version string for a deployment.
VERSION=0.1.0

# PostgreSQL
POSTGRES_DB=novelhub
POSTGRES_USER=novelhub
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql+asyncpg://novelhub:CHANGE_ME@postgres:5432/novelhub

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Meilisearch
MEILI_MASTER_KEY=CHANGE_ME

# Backend
# Host port docker-compose publishes for the backend container (which always
# listens on 8000 internally).  Leave unset to keep the historical default.
BACKEND_PORT=8000

# Frontend
# Host port docker-compose publishes for the frontend dev server.
FRONTEND_PORT=5173

# nginx
# Host port docker-compose publishes for the nginx container (port 80 inside).
# This is the entry point users open; put it behind your own reverse proxy or
# tunnel if you expose NovelHub to the internet.
NGINX_PORT=8088

# Timezone
TZ=Asia/Shanghai

# JWT
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Cookie encryption
COOKIE_SECRET=CHANGE_ME

# Meilisearch
MEILI_HOST=http://meilisearch:7700
MEILI_KEY=CHANGE_ME_meili_key

# Storage
STORAGE_PATH=/app/storage/books

# Local Markdown import: host directory mounted into the container at /imports
LOCAL_IMPORT_VOLUME=./data/imports
# Container-visible roots selectable in the local import UI
LOCAL_IMPORT_ROOTS=/app/storage/imports,/imports,/library

# Database connection pool, per Python process.
# Every process owns its own pool (each backend uvicorn worker, the queue
# worker, each celery worker), so the sum across the stack must stay under
# the database's max_connections. Bump these only together with the database
# side -- a bigger pool here without headroom there just moves the failure
# from "QueuePool limit" to "too many clients already".
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Outbound proxy used before Admin -> 代理 has been configured.  Once the admin
# setting is saved it wins; these two only seed the default.
# HTTP_PROXY=
# HTTPS_PROXY=

# Crawler
# Fallback request interval when a book source has no concurrentRate.
# 1200ms is safer for full-site sync; set 0 to match Legado's unthrottled default.
CRAWL_DELAY_MS=1200
# Long-running syncs pause briefly every N requests to avoid tripping site WAFs.
SYNC_RATE_COOLDOWN_EVERY=300
SYNC_RATE_COOLDOWN_SECONDS=10
# Effective thread pool size used for page/chapter fetches (Legado caps at 9)
SYNC_THREAD_COUNT=9
# Chapter download concurrency
SYNC_CHAPTER_CONCURRENCY=9
# Concurrent books during full-site sync (1 = fully sequential).
# A task holds 1 + this many DB connections (its own session plus one per
# concurrently syncing book), so the queue's task budget is divided by it:
# with the defaults below, (10 + 20 - 4 reserve) / (1 + 3) = 6 tasks.
SYNC_BOOK_CONCURRENCY=3
# false waits for the current 3-book batch to finish before starting the next
# batch (safer for anti-bot limits); true starts the next book as soon as one
# book in the batch finishes
SYNC_BOOK_CONTINUOUS=false
# Set to true to ignore book source concurrentRate and use the chapter concurrency above
SYNC_IGNORE_RATE_LIMIT=false
# How many book sources may sync at the same time.
# 0 = unlimited: every source gets its own worker, so one multi-hour full-site
# task can no longer block the other sources -- but still bounded by the pool
# budget above (with the defaults: 6 tasks at SYNC_BOOK_CONCURRENCY=3, see the
# note on that variable). Set a positive number only to keep a stricter
# ceiling on a small host. A single source never runs two tasks at once,
# and each source keeps its own request pacing either way.
SYNC_WORKER_CONCURRENCY=0
# Concurrent catalog categories (exploreUrl kinds) fetched per source. This does
# not raise the request rate a site sees: the source's own rate limiter still
# spaces every request.
YUEDU_EXPLORE_CONCURRENCY=4
# Stop a full-site task after N pages and automatically re-queue it (0 = unlimited)
SYNC_PAGE_BATCH_SIZE=0
# Delay before a batched task is re-queued, in milliseconds
SYNC_BATCH_INTERVAL_MS=5000
# Pages per source the *scheduled* auto sync may crawl (see docs/full-site-sync.md
# "自动更新").  A scheduled refresh must stay bounded; a manual full-site sync
# ignores this and uses its own max_pages.
AUTO_SYNC_MAX_PAGES=3

# Abort one book after this many consecutive *transient* chapter failures
# (5xx/timeout/connection).  The book is retried later instead of hammering
# every chapter while the origin is unavailable.
SYNC_MAX_CONSECUTIVE_CHAPTER_FAILURES=5
# Upper bound for the images downloaded and rewritten inside a single chapter.
# Manga/photo albums routinely hold 100+ pages, so this has to stay well above
# the old 50-image cap.
MAX_CONTENT_IMAGES_PER_CHAPTER=512

# Queue worker liveness. The crawler container (PID 1) restarts itself when the
# queue loop stops touching this file, because a worker whose loop hangs stays
# alive while consuming no task at all -- nothing else can see that.
# How long the signal may stay untouched before the worker counts as hung. The
# queue loop iterates at least every 2s even while idle, so only a real hang
# reaches this. 0 / junk falls back to the default.
SYNC_QUEUE_HEARTBEAT_TIMEOUT_SECONDS=300
# Where the signal lives; the container entry point and the worker both read it.
SYNC_QUEUE_HEARTBEAT_PATH=/tmp/novelhub_queue_heartbeat

# A task must stop when the user pauses/cancels it, but it can only stop at its
# own checkpoint.  After this many seconds the worker stops waiting and cancels
# the coroutine (the row already holds the requested state).
SYNC_TASK_STOP_GRACE_SECONDS=120
# How often the worker re-reads the state of the tasks it is running.
SYNC_TASK_SUPERVISE_INTERVAL_SECONDS=15
# A running task that reports no progress for this long is treated as hung and
# failed, so its queue slot comes back. 0 disables the watchdog.  The default is
# deliberately generous: a source throttled to one request per minute can
# legitimately report a page only every few minutes.
SYNC_TASK_STALL_SECONDS=3600
# Automatic retry of a *transiently* failed task: first delay, then
# delay * 2 * attempt.
SYNC_TASK_RETRY_BASE_SECONDS=60
# How many of those automatic retries a task gets before it stays failed.
SYNC_TASK_MAX_AUTO_RETRIES=2

# Headless-browser (webJs / webView) book sources: how many Chromium instances
# may run at once. Each one costs roughly 200-300MB, so raise it only together
# with the crawler container's memory limit.
YUEDU_PLAYWRIGHT_CONCURRENCY=3
# Upper bound for walking one image album ("下一张/下一页" chain) before giving
# up, so a looping next-link cannot download forever.
YUEDU_GALLERY_MAX_PAGES=512
# How many retired HTTP clients the yuedu transport may keep before dropping the
# oldest. Guards against an unbounded backlog while a proxy is being restarted.
YUEDU_HTTP_MAX_RETIRED_CLIENTS=4

# =====================
# AI Configuration
# =====================

# Provider: openai | claude | qwen | ollama | hermes
AI_PROVIDER=openai
AI_API_KEY=sk-your-api-key
# AI_BASE_URL=  (optional, custom endpoint)
# AI_MODEL=     (optional, uses provider default)

# =====================
# API Tokens
# =====================
# Generate in 设置 -> API 令牌, or via POST /api/tokens.
# Send it as the X-API-Token header.  Tokens are accepted by the read-only
# library endpoints only (book list/detail, chapter list/body, search) so a
# token pasted into a third-party reader cannot write or delete anything.
