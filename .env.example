# =====================
# NovelHub Environment
# =====================

PROJECT_NAME=NovelHub

# PostgreSQL
POSTGRES_DB=novelhub
POSTGRES_USER=novelhub
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql+asyncpg://novelhub:CHANGE_ME@postgres:5432/novelhub

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Meilisearch
MEILI_MASTER_KEY=CHANGE_ME

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173

# Timezone
TZ=Asia/Shanghai

# JWT
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Cookie encryption
COOKIE_SECRET=CHANGE_ME

# Meilisearch
MEILI_HOST=http://meilisearch:7700
MEILI_KEY=CHANGE_MEili_key

# Storage
STORAGE_PATH=/app/storage/books

# Crawler
# Fallback request interval when a book source has no concurrentRate.
# 0 matches Legado's default (unthrottled); set e.g. 1200 to force a delay.
CRAWL_DELAY_MS=0
# Effective thread pool size used for page/chapter fetches (Legado caps at 9)
SYNC_THREAD_COUNT=9
# Chapter download concurrency
SYNC_CHAPTER_CONCURRENCY=9
# Concurrent books during full-site sync (1 = fully sequential)
SYNC_BOOK_CONCURRENCY=3
# false waits for the current 3-book batch to finish before starting the next
# batch (safer for anti-bot limits); true starts the next book as soon as one
# book in the batch finishes
SYNC_BOOK_CONTINUOUS=false
# Set to true to ignore book source concurrentRate and use the chapter concurrency above
SYNC_IGNORE_RATE_LIMIT=false
# How many crawl tasks/sources the queue worker runs at the same time
SYNC_WORKER_CONCURRENCY=3
# Stop a full-site task after N pages and automatically re-queue it (0 = unlimited)
SYNC_PAGE_BATCH_SIZE=0
# Delay before a batched task is re-queued, in milliseconds
SYNC_BATCH_INTERVAL_MS=5000

# =====================
# AI Configuration
# =====================

# Provider: openai | claude | qwen | ollama | hermes
AI_PROVIDER=openai
AI_API_KEY=sk-your-api-key
# AI_BASE_URL=  (optional, custom endpoint)
# AI_MODEL=     (optional, uses provider default)

# =====================
# Storage Backend
# =====================

# local | s3 | webdav
STORAGE_BACKEND=local

# S3/MinIO settings (when STORAGE_BACKEND=s3)
# S3_ENDPOINT=
# S3_BUCKET=novelhub-books
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# WebDAV settings (when STORAGE_BACKEND=webdav)
# WEBDAV_URL=
# WEBDAV_USER=
# WEBDAV_PASS=

# =====================
# API Tokens
# =====================
# Generate via POST /api/tokens
